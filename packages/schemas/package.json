{
  "name": "@fie/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "JSON Schema contracts shared by the API, field app, and reviewer console",
  "type": "module",
  "files": [
    "schemas",
    "dist"
  ],
  "exports": {
    "./schemas/*": "./schemas/*",
    "./types/*": "./dist/*.schema.d.ts"
  },
  "scripts": {
    "generate:ts": "json2ts --input 'schemas/*.schema.json' --output dist --cwd schemas",
    "validate": "node validate.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4"
  }
}
