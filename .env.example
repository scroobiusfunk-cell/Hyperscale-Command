# Copy to .env for local development. Never commit .env.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=understudy
POSTGRES_PASSWORD=understudy_local_dev
POSTGRES_DB=understudy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://understudy:understudy_local_dev@localhost:5432/understudy

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3 in deployed environments) ----------
# Pin these once a known-good release has been pulled; see infra/docker-compose.yml.
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=understudy_minio
MINIO_ROOT_PASSWORD=understudy_minio_local_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=understudy_minio
STORAGE_SECRET_KEY=understudy_minio_local_dev
EVIDENCE_BUCKET=understudy-evidence
DOCUMENTS_BUCKET=understudy-documents
EXPORTS_BUCKET=understudy-exports

# --- Application ----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Auth -----------------------------------------------------------------
# Company SSO over OIDC. The dev identity provider is refused outside
# ENVIRONMENT=development: safety rulings must carry a real identity.
# See docs/OPEN_QUESTIONS.md Q7.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_DEV_IDENTITY_ENABLED=true

# --- CxAlloy --------------------------------------------------------------
# The API is READ ONLY. Results leave this platform as an export package, not
# a write. See docs/adr/0001-cxalloy-read-only-results-export.md.
CXALLOY_BASE_URL=
CXALLOY_API_KEY=
CXALLOY_PROJECT_ID=

# --- LLM provider adapter -------------------------------------------------
# Used by the Requirements Compiler extraction step only. Model version is
# pinned per prompt version in code, not here.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
