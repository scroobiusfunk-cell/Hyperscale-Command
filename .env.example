# Copy to .env for local development. Never commit .env.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=fie
POSTGRES_PASSWORD=fie_local_dev
POSTGRES_DB=fie
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fie:fie_local_dev@localhost:5432/fie

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3 in deployed environments) ----------
# Pin these once a known-good release has been pulled; see infra/docker-compose.yml.
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=fie_minio
MINIO_ROOT_PASSWORD=fie_minio_local_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=fie_minio
STORAGE_SECRET_KEY=fie_minio_local_dev
EVIDENCE_BUCKET=fie-evidence
DOCUMENTS_BUCKET=fie-documents
EXPORTS_BUCKET=fie-exports

# --- Application ----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Auth -----------------------------------------------------------------
# Company SSO over OIDC. The dev identity provider is refused outside
# ENVIRONMENT=development: safety rulings must carry a real identity.
# See docs/OPEN_QUESTIONS.md Q7.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_DEV_IDENTITY_ENABLED=true

# --- CxAlloy --------------------------------------------------------------
# The API is READ ONLY. Results leave this platform as an export package, not
# a write. See docs/adr/0001-cxalloy-read-only-results-export.md.
CXALLOY_BASE_URL=
CXALLOY_API_KEY=
CXALLOY_PROJECT_ID=

# --- LLM provider adapter -------------------------------------------------
# Used by the Requirements Compiler extraction step only. Model version is
# pinned per prompt version in code, not here.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
